{
  "version": 1,
  "hooks": {
    "postToolUse": [
      { "type": "command", "bash": "h=.claude/hooks/format-changed.sh; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null", "cwd": ".", "timeoutSec": 60 }
    ],
    "agentStop": [
      { "type": "command", "bash": "h=.claude/hooks/remind-docs.sh; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null", "cwd": ".", "timeoutSec": 30 }
    ]
  }
}
