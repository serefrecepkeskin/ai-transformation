{
  // Auto-approve safe, read-only and dev-loop terminal commands for Copilot
  // agent mode to cut approval-prompt noise. false = always ask.
  // Deliberately NOT set: "chat.tools.autoApprove" (global) — it disables the
  // safety mechanism entirely. Keys support exact strings or /regex/.
  "chat.tools.terminal.autoApprove": {
    "/^git (status|diff|log|show|branch)\\b/": true,
    "git add": true,
    "/^npm run (lint|test|typecheck|format:check|build)\\b/": true,
    "/^npx (prettier|eslint|tsc|vitest|playwright)\\b/": true,
    "/^rm -rf\\b/": false,
    "/^git push --force/": false,
    "/^git reset --hard/": false
  }
}
