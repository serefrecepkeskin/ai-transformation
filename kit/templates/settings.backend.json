{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --show-current)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(pylint --errors-only:*)",
      "Bash(.venv/bin/pylint --errors-only:*)",
      "Bash(pre-commit run:*)",
      "Bash(alembic check)",
      "Bash(alembic heads)",
      "Bash(alembic current)",
      "Bash(alembic history:*)",
      "Edit(default.ini)",
      "Edit(.env.example)"
    ],
    "ask": [
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(alembic revision:*)",
      "Bash(psql:*)",
      "Bash(PGPASSWORD=*)",
      "Bash(docker exec:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pip install:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Edit(.claude/settings.local.json)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(.husky/**)",
      "Edit(.mcp.json)",
      "Edit(.vscode/**)",
      "Edit(.github/workflows/**)",
      "Edit(.github/hooks/**)",
      "Edit(**/.claude/settings.local.json)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(/config/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*credential*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(/config/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(**/*.bak-*)",
      "Edit(**/*.bak-*)",
      "Read(**/.local/private/**)",
      "Edit(**/.local/private/**)",
      "Read(.env.*.local)",
      "Edit(.env.*.local)",
      "Read(.env.staging)",
      "Edit(.env.staging)",
      "Read(.env.test)",
      "Edit(.env.test)",
      "Read(.env.dev)",
      "Edit(.env.dev)",
      "Read(.env.prod)",
      "Edit(.env.prod)",
      "Read(.env.backup)",
      "Edit(.env.backup)",
      "Read(.env.*.bak*)",
      "Edit(.env.*.bak*)",
      "Read(*.bak-*)",
      "Edit(*.bak-*)",
      "Read(.envrc)",
      "Edit(.envrc)",
      "Read(*.tfvars)",
      "Edit(*.tfvars)",
      "Read(*.tfstate)",
      "Edit(*.tfstate)",
      "Read(*.tfstate.*)",
      "Edit(*.tfstate.*)",
      "Read(.pgpass)",
      "Edit(.pgpass)",
      "Read(.pypirc)",
      "Edit(.pypirc)",
      "Read(.netrc)",
      "Edit(.netrc)",
      "Read(*.jks)",
      "Edit(*.jks)",
      "Read(*.keystore)",
      "Edit(*.keystore)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(.local/private/**)",
      "Edit(.local/private/**)",
      "Read(~/.docker/config.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-changed.sh\"; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-docs.sh\"; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-gate.sh\"; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
