{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --show-current)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Read(**/.env.example)",
      "Edit(**/.env.example)",
      "Bash(agent-kit/scripts/check-drift.sh:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(agent-kit/scripts/link-repo.sh:*)",
      "Bash(psql:*)",
      "Bash(PGPASSWORD=*)",
      "Bash(docker exec:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(alembic revision:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Read(agent-kit/humans/**)",
      "Edit(agent-kit/hooks/**)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(.husky/**)",
      "Edit(.mcp.json)",
      "Edit(.vscode/**)",
      "Edit(.github/workflows/**)",
      "Edit(.github/hooks/**)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(.env.dev)",
      "Read(.env.prod)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.staging)",
      "Edit(.env.test)",
      "Edit(.env.dev)",
      "Edit(.env.prod)",
      "Read(*/config/**)",
      "Edit(*/config/**)",
      "Read(**/e2e/.auth/**)",
      "Edit(**/e2e/.auth/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*credential*)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Edit(agent-kit/skills/impeccable/**)",
      "Edit(*/.claude/settings.json)",
      "Edit(*/.claude/hooks/**)",
      "Edit(*/.claude/agents/**)",
      "Edit(*/.claude/skills/**)",
      "Edit(.claude/settings.json)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(**/*.bak-*)",
      "Edit(**/*.bak-*)",
      "Read(**/.local/private/**)",
      "Edit(**/.local/private/**)",
      "Read(.env.backup)",
      "Edit(.env.backup)",
      "Read(.env.*.bak*)",
      "Edit(.env.*.bak*)",
      "Read(*.bak-*)",
      "Edit(*.bak-*)",
      "Read(.envrc)",
      "Edit(.envrc)",
      "Read(*.tfvars)",
      "Edit(*.tfvars)",
      "Read(*.tfstate)",
      "Edit(*.tfstate)",
      "Read(*.tfstate.*)",
      "Edit(*.tfstate.*)",
      "Read(.pgpass)",
      "Edit(.pgpass)",
      "Read(.pypirc)",
      "Edit(.pypirc)",
      "Read(.netrc)",
      "Edit(.netrc)",
      "Read(*.jks)",
      "Edit(*.jks)",
      "Read(*.keystore)",
      "Edit(*.keystore)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(.local/private/**)",
      "Edit(.local/private/**)",
      "Read(~/.docker/config.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"$CLAUDE_PROJECT_DIR/agent-kit/hooks/pr-gate.sh\"; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"$CLAUDE_PROJECT_DIR/agent-kit/hooks/format-changed.sh\"; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"$CLAUDE_PROJECT_DIR/agent-kit/hooks/remind-docs.sh\"; [ -x \"$h\" ] && exec \"$h\"; cat >/dev/null'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
