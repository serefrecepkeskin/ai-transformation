{
  "inputs": [
    {
      "id": "mssql-connection-string",
      "type": "promptString",
      "description": "SQL Server salt okunur bağlantı dizesi",
      "password": true
    },
    {
      "id": "postgres-uri",
      "type": "promptString",
      "description": "PostgreSQL salt okunur bağlantı URI'si",
      "password": true
    },
    {
      "id": "mysql-password",
      "type": "promptString",
      "description": "MySQL salt okunur kullanıcı parolası",
      "password": true
    },
    {
      "id": "oracle-connection-string",
      "type": "promptString",
      "description": "Oracle salt okunur bağlantı dizesi",
      "password": true
    }
  ],
  "servers": {
    "mssql": {
      "command": "npx",
      "args": [
        "-y",
        "mssql-mcp-server"
      ],
      "env": {
        "MSSQL_CONNECTION_STRING": "${input:mssql-connection-string}"
      }
    },
    "postgres": {
      "command": "uvx",
      "args": [
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${input:postgres-uri}"
      }
    },
    "mysql": {
      "command": "uvx",
      "args": [
        "mysql-mcp-server"
      ],
      "env": {
        "MYSQL_HOST": "TODO-host",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "TODO-readonly-user",
        "MYSQL_PASSWORD": "${input:mysql-password}",
        "MYSQL_DATABASE": "TODO-database"
      }
    },
    "oracle": {
      "command": "TODO-company-approved-oracle-mcp",
      "args": [],
      "env": {
        "ORACLE_CONNECTION_STRING": "${input:oracle-connection-string}"
      }
    }
  }
}
